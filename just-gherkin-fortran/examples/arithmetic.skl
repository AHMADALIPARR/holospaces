MODULE arithmetic

FUNCTOR ADD
    INPUT : VECTOR[F64]
    OUTPUT : VECTOR[F64]
    OPERATION:
        RESULT = LEFT + RIGHT
    END
END

FUNCTOR NORMALIZE
    INPUT : VECTOR[F64]
    OUTPUT : VECTOR[F64]
    REQUIRES:
        NORM(INPUT) > 0
    END
    OPERATION:
        RESULT = INPUT / NORM(INPUT)
    END
    ENSURES:
        NORM(RESULT) ~= 1.0
    END
END

PIPELINE COMPUTE
    APPLY ADD
    APPLY NORMALIZE
    VERIFY ALL
END
